# dev | uat (base URLs are in config/environments.ts)
TEST_ENV=uat
# Optional: overrides the base URL of TEST_ENV
BASE_URL=

# 1 = open a headed browser and wait for you to finish Microsoft sign-in (MFA) yourself
MANUAL_LOGIN=0
# 1 = record every test, slowed down so it can be followed (SLOWMO=ms to change, 0 = off)
VIDEO=0
SLOWMO=

SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=
END_USER_EMAIL=
END_USER_PASSWORD=
UPLOADER_EMAIL=
UPLOADER_PASSWORD=
